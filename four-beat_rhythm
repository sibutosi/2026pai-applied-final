#!/usr/bin/env python3
import math
import time
import rclpy
from rclpy.node import Node
from trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint

# CRANE+ V2 の関節定義（アーム4軸＋ハンド1軸）
ARM_JOINT_NAMES = ['crane_plus_joint1', 'crane_plus_joint2', 'crane_plus_joint4', 'crane_plus_joint3']
GRIPPER_JOINT_NAME = 'crane_plus_joint_hand'

# グリッパーの開閉限界値
GRIPPER_OPEN = -0.5236   # 約 -30度
GRIPPER_CLOSE = 0.1745   # 約 +10度

class CraneConductorController(Node):
    def __init__(self):
        super().__init__('crane_conductor_controller')
        
        # ROS 2 control の個別コントローラトピックへ接続
        self.arm_pub = self.create_publisher(
            JointTrajectory, 
            '/crane_plus_arm_controller/joint_trajectory', 
            10
        )
        self.gripper_pub = self.create_publisher(
            JointTrajectory, 
            '/crane_plus_gripper_controller/joint_trajectory', 
            10
        )
        
        self.start_time = time.time()
        # 33Hz（約0.03秒周期）で滑らかに軌道指令を送信
        self.timer = self.create_timer(0.03, self.publish_commands)
        self.get_logger().info("マエストロ CRANE+ V2：4拍子指揮を開始します！")

    def publish_commands(self):
        t = time.time() - self.start_time

        # 1小節の周期（3.8秒）と進行度（0.0 〜 1.0）
        bar_duration = 3.8
        p = (t % bar_duration) / bar_duration

        # -----------------------------------------------------------------
        # 指揮法に基づく区分補間（折れ線軌道）
        # Joint 1: 左右旋回 (-: 左, +: 右)
        # Joint 2: 前傾・沈み込み (-: 低い/前傾, +: 高い/直立)
        # Joint 3: 肘の曲げ伸ばし (+: 曲げる, -: 伸ばす)
        # Joint 4: 手首の点打ち・スナップ (-: 下向き, +: 上向き)
        # -----------------------------------------------------------------

        if p < 0.13:
            # 【1拍目：強打・垂直急降下】直立からテーブル直前までアームを叩き落とす
            s = p / 0.13
            j1 = 0.0
            j2 = 0.85 - 1.95 * s      # 限界まで深く沈み込む
            j3 = 0.15 + 1.30 * s      # 肘を深く曲げて衝撃を吸収
            j4 = -0.1 - 1.20 * s      # 手首を真下へ鋭くスナップ
            gripper = GRIPPER_OPEN

        elif p < 0.25:
            # 【1拍目：リバウンド】最深部から中央やや上まで反動で跳ね上げる
            s = (p - 0.13) / 0.12
            j1 = -0.2 * s
            j2 = -1.1 + 1.2 * s       
            j3 = 1.45 - 0.8 * s       
            j4 = -1.3 + 1.2 * s       # 手首を水平に戻す
            gripper = GRIPPER_CLOSE

        elif p < 0.38:
            # 【2拍目：左下への切り込み】左端限界かつ低い位置へ沈み込む
            s = (p - 0.25) / 0.13
            j1 = -0.2 - 1.2 * s       # 左限界 -80度
            j2 = 0.1 - 0.9 * s        # 左下の低空へ
            j3 = 0.65 + 0.65 * s      
            j4 = -0.1 - 1.0 * s       # 左下でガツンと止める
            gripper = GRIPPER_CLOSE

        elif p < 0.50:
            # 【2拍目：左上への跳ね上げ】左端を維持したまま上空高くへ特大振り上げ
            s = (p - 0.38) / 0.12
            j1 = -1.4 + 0.1 * s       # 左端キープ
            j2 = -0.8 + 1.6 * s       # 左上空高くへ引き上げ
            j3 = 1.30 - 0.9 * s       # アームを伸ばす
            j4 = -1.1 + 1.1 * s
            gripper = GRIPPER_CLOSE

        elif p < 0.65:
            # 【3拍目：右下への薙ぎ払い】左上から右端へ全空間を横断して沈み込む
            s = (p - 0.50) / 0.15
            j1 = -1.3 + 2.7 * s       # 左から右へ大横断
            j2 = 0.8 - 1.5 * s        # 右下の低空へ沈む
            j3 = 0.40 + 0.8 * s       
            j4 = 0.0 - 1.1 * s        # 右下でピシッと点打ち
            gripper = GRIPPER_OPEN * 0.6

        elif p < 0.75:
            # 【3拍目：右上への跳ね上げ】右下から右上へ持ち上げる
            s = (p - 0.65) / 0.10
            j1 = 1.4 - 0.1 * s        # 右端キープ
            j2 = -0.7 + 1.2 * s       
            j3 = 1.20 - 0.6 * s
            j4 = -1.1 + 1.1 * s
            gripper = GRIPPER_OPEN * 0.6

        elif p < 0.90:
            # 【4拍目：すくい上げ】右から中央最頂点へタクトを天高く突き上げる
            s = (p - 0.75) / 0.15
            j1 = 1.3 - 1.3 * s        # 中央へ戻す
            j2 = 0.5 + 0.35 * s       # 最高点到達
            j3 = 0.60 - 0.45 * s      # 直立姿勢
            j4 = 0.0 + 0.2 * s
            gripper = GRIPPER_CLOSE

        else:
            # 【アウフタクト：呼吸・タメ】中央頂点で静止し、次の1拍目への予備動作
            j1 = 0.0
            j2 = 0.85
            j3 = 0.15
            j4 = 0.2
            gripper = GRIPPER_OPEN

        # アーム軌道メッセージの生成・送信
        jt = JointTrajectory()
        jt.joint_names = ARM_JOINT_NAMES
        pt = JointTrajectoryPoint()
        pt.positions = [j1, j2, j4, j3]
        pt.time_from_start.sec = 0
        pt.time_from_start.nanosec = int(0.05 * 1e9)
        jt.points.append(pt)
        self.arm_pub.publish(jt)

        # グリッパー軌道メッセージの生成・送信
        jt_g = JointTrajectory()
        jt_g.joint_names = [GRIPPER_JOINT_NAME]
        pt_g = JointTrajectoryPoint()
        pt_g.positions = [gripper]
        pt_g.time_from_start.sec = 0
        pt_g.time_from_start.nanosec = int(0.05 * 1e9)
        jt_g.points.append(pt_g)
        self.gripper_pub.publish(jt_g)

def main():
    rclpy.init()
    node = CraneConductorController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
