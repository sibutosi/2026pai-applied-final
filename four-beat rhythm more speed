#!/usr/bin/env python3
import math
import time
import rclpy
from rclpy.node import Node
from trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint

# CRANE+ V2 の関節定義（アーム4軸＋ハンド1軸）
ARM_JOINT_NAMES = ['crane_plus_joint1', 'crane_plus_joint2', 'crane_plus_joint4', 'crane_plus_joint3']
GRIPPER_JOINT_NAME = 'crane_plus_joint_hand'

# グリッパーの開閉限界値
GRIPPER_OPEN = -0.5236   # 約 -30度
GRIPPER_CLOSE = 0.1745   # 約 +10度

class CraneConductorController(Node):
    def __init__(self):
        super().__init__('crane_conductor_controller')
        
        self.arm_pub = self.create_publisher(
            JointTrajectory, 
            '/crane_plus_arm_controller/joint_trajectory', 
            10
        )
        self.gripper_pub = self.create_publisher(
            JointTrajectory, 
            '/crane_plus_gripper_controller/joint_trajectory', 
            10
        )
        
        self.bar_duration = 3.8
        self.start_time = time.time()
        # 33Hz周期で指令送信
        self.timer = self.create_timer(0.03, self.publish_commands)
        self.get_logger().info("マエストロ CRANE+ V2：超高速手首スナップ指揮を開始します！")

    def publish_commands(self):
        t = time.time() - self.start_time
        p = (t % self.bar_duration) / self.bar_duration

        # -----------------------------------------------------------------
        # 腕の基本軌道（j1, j2, j3）は維持しつつ、手首（j4）を急加速スナップさせる
        # -----------------------------------------------------------------

        if p < 0.13:
            # 【1拍目：強打・垂直急降下】
            s = p / 0.13
            j1 = 0.0
            j2 = 0.85 - 1.95 * s
            j3 = 0.15 + 1.30 * s
            # 手首：最後の一瞬で急激に真下へ叩きつける（s^4 による急加速スナップ）
            snap = s ** 4
            j4 = 0.80 - 2.40 * snap   # +0.80 から 一気に -1.60 へ叩き落とす
            gripper = GRIPPER_CLOSE + (GRIPPER_OPEN - GRIPPER_CLOSE) * (s ** 2)

        elif p < 0.25:
            # 【1拍目：高速リバウンド】
            s = (p - 0.13) / 0.12
            j1 = -0.2 * s
            j2 = -1.1 + 1.2 * s
            j3 = 1.45 - 0.8 * s
            # 打点の衝撃で瞬間的に跳ね上がる（平方根イージングで初速MAX）
            rebound = math.sqrt(s)
            j4 = -1.60 + 2.30 * rebound   # -1.60 -> +0.70
            gripper = GRIPPER_OPEN + (GRIPPER_CLOSE - GRIPPER_OPEN) * s

        elif p < 0.38:
            # 【2拍目：左下への切り込み】
            s = (p - 0.25) / 0.13
            j1 = -0.2 - 1.2 * s
            j2 = 0.1 - 0.9 * s
            j3 = 0.65 + 0.65 * s
            # 左下打点への鋭いスナップ
            snap = s ** 3
            j4 = 0.70 - 2.20 * snap   # +0.70 -> -1.50
            g_snap = math.sin(s * math.pi)
            gripper = GRIPPER_CLOSE + (GRIPPER_OPEN * 0.5 - GRIPPER_CLOSE) * g_snap

        elif p < 0.50:
            # 【2拍目：左上への跳ね上げ】
            s = (p - 0.38) / 0.12
            j1 = -1.4 + 0.1 * s
            j2 = -0.8 + 1.6 * s
            j3 = 1.30 - 0.9 * s
            rebound = math.sqrt(s)
            j4 = -1.50 + 2.30 * rebound   # -1.50 -> +0.80
            gripper = GRIPPER_CLOSE

        elif p < 0.65:
            # 【3拍目：右下への薙ぎ払い】
            s = (p - 0.50) / 0.15
            j1 = -1.3 + 2.7 * s
            j2 = 0.8 - 1.5 * s
            j3 = 0.40 + 0.8 * s
            # 右下へ横断しながら、最後に手首を電光石火で叩きつける
            snap = s ** 3
            j4 = 0.80 - 2.30 * snap   # +0.80 -> -1.50
            g_snap = math.sin(s * math.pi)
            gripper = GRIPPER_CLOSE + (GRIPPER_OPEN * 0.7 - GRIPPER_CLOSE) * g_snap

        elif p < 0.75:
            # 【3拍目：右上への跳ね上げ】
            s = (p - 0.65) / 0.10
            j1 = 1.4 - 0.1 * s
            j2 = -0.7 + 1.2 * s
            j3 = 1.20 - 0.6 * s
            rebound = math.sqrt(s)
            j4 = -1.50 + 2.20 * rebound   # -1.50 -> +0.70
            gripper = GRIPPER_CLOSE

        elif p < 0.90:
            # 【4拍目：すくい上げ】
            s = (p - 0.75) / 0.15
            j1 = 1.3 - 1.3 * s
            j2 = 0.5 + 0.35 * s
            j3 = 0.60 - 0.45 * s
            # 鋭く下をくぐってから天高くピンと突き上げる
            j4 = 0.70 - 1.80 * math.sin(s * math.pi) + 0.15 * s
            gripper = GRIPPER_CLOSE + (GRIPPER_OPEN * 0.4 - GRIPPER_CLOSE) * s

        else:
            # 【アウフタクト：呼吸・タメ】
            s = (p - 0.90) / 0.10
            j1 = 0.0
            j2 = 0.85
            j3 = 0.15
            j4 = 0.85 - 0.05 * s
            gripper = (GRIPPER_OPEN * 0.4) + (GRIPPER_CLOSE - (GRIPPER_OPEN * 0.4)) * s

        # アーム軌道メッセージ送信（時間応答性を0.03秒に詰めてキレを向上）
        jt = JointTrajectory()
        jt.joint_names = ARM_JOINT_NAMES
        pt = JointTrajectoryPoint()
        pt.positions = [j1, j2, j4, j3]
        pt.time_from_start.sec = 0
        pt.time_from_start.nanosec = int(0.03 * 1e9)
        jt.points.append(pt)
        self.arm_pub.publish(jt)

        # グリッパー軌道メッセージ送信
        jt_g = JointTrajectory()
        jt_g.joint_names = [GRIPPER_JOINT_NAME]
        pt_g = JointTrajectoryPoint()
        pt_g.positions = [gripper]
        pt_g.time_from_start.sec = 0
        pt_g.time_from_start.nanosec = int(0.03 * 1e9)
        jt_g.points.append(pt_g)
        self.gripper_pub.publish(jt_g)

def main():
    rclpy.init()
    node = CraneConductorController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
